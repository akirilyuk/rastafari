{
  "name": "Rastafari",
  "install": "npm ci && bash scripts/install-tokensave.sh",
  "start": "command -v tokensave >/dev/null && tokensave sync || true",
  "terminals": [
    {
      "name": "dev",
      "command": "npm run dev",
      "description": "Next.js dev server (Turbopack) on http://127.0.0.1:43127"
    }
  ],
  "ports": [
    {
      "name": "web",
      "port": 43127
    }
  ]
}
