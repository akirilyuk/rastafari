GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://127.0.0.1:43127

# Supabase (users, shops, reviews, claims, products, courses, ads).
# Create a project, run supabase/schema.sql in the SQL editor, then fill these in.
# Without them the app still runs on browser localStorage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CARTO dark basemap. The live value used by the map is src/lib/carto.ts.
NEXT_PUBLIC_CARTO_API_KEY=cb1_3zv0_1_1a9763af4dd73d0f6b058cf0
